{
  "$schema": "./node_modules/@angular/service-worker/config/schema.json",
  "index": "/index.html",
  "assetGroups": [
    {
      "name": "app",
      "installMode": "prefetch",
      "resources": {
        "files": ["/favicon.ico", "/index.html", "/manifest.webmanifest", "/*.css", "/*.js", "/media/**"]
      }
    },
    {
      "name": "assets",
      "installMode": "prefetch",
      "updateMode": "prefetch",
      "resources": {
        "files": ["/assets/**", "/media/**", "/*.(svg|cur|jpg|jpeg|png|apng|webp|avif|gif|otf|ttf|woff|woff2)"]
      }
    },
    {
      "name": "geo-assets",
      "installMode": "prefetch",
      "updateMode": "prefetch",
      "resources": {
        "files": [
          "/assets/geo/**/*.geojson",
          "/assets/geo/**/*.json"
        ]
      }
    }
  ],
  "dataGroups": [
    {
      "name": "dhis2-api",
      "urls": ["https://phsmis.health.gov.lk/api/**"],
      "cacheConfig": {
        "strategy": "freshness",
        "maxSize": 100,
        "maxAge": "1d",
        "timeout": "5s"
      }
    },
    {
      "name": "dhis2-geometry",
      "urls": [
        "**/api/organisationUnits/**/geometry.geojson"
      ],
      "cacheConfig": {
        "maxSize": 50,
        "maxAge": "30d",
        "timeout": "5s",
        "strategy": "performance"
      }
    }
  ]
}
